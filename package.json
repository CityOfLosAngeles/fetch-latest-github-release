{
  "name": "fetch-latest-github-release",
  "description": "A tiny GitHub action to fetch the latest GitHub Release for a given repository. Originally forked from https://github.com/gregziegan/fetch-latest-release on 2023/04/27",
  "version": "3.0.0",
  "author": "City of Los Angeles",
  "private": true,
  "homepage": "https://github.com/CityOfLosAngeles/fetch-latest-github-release#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityoflosangeles/fetch-latest-github-release.git"
  },
  "bugs": {
    "url": "https://github.com/CityOfLosAngeles/fetch-latest-github-release/issues"
  },
  "keywords": [
    "actions"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "build": "ncc build src/index.ts -o dist --source-map && mv dist/index.js dist/index.cjs",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npm run build",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run coverage && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "config": "^3.3.12",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.8",
    "@github/local-action": "7.0.0",
    "@jest/globals": "^29.7.0",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/config": "^3.3.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.30",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.7.0",
    "make-coverage-badge": "^1.2.0",
    "nock": "^13.5.6",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.3.0",
    "rollup": "4.59.0",
    "ts-jest": "^29.3.2",
    "ts-jest-resolver": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "@eslint/plugin-kit": "0.3.4",
    "@octokit/request@>=10 <11": "10.0.14",
    "ajv": "6.14.0",
    "brace-expansion@<2": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "diff": "4.0.4",
    "fast-xml-parser": "5.7.0",
    "flatted": "3.4.2",
    "glob@>=10 <11": "10.5.0",
    "js-yaml@<4": "3.15.1",
    "js-yaml@>=4 <5": "4.3.1",
    "lodash": "4.18.1",
    "minimatch@<4": "3.1.4",
    "minimatch@>=5 <6": "5.1.8",
    "minimatch@>=9 <10": "9.0.7",
    "picomatch@<3": "2.3.2",
    "picomatch@>=4 <5": "4.0.4",
    "undici@<7": "6.28.0",
    "yaml": "2.8.3"
  }
}
